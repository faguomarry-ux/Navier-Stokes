# Local compilation, rendering and verification scratch space
/tmp/
/build/
/.cache/
/compile-*.txt

# The root PDF duplicates the published copy under output/pdf/.
/fluid_mechanics_from_conservation_to_ns.pdf

# Track one reviewed PDF; ignore other generated output.
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/fluid_mechanics_from_conservation_to_ns.pdf

# Python environments and bytecode used by verification scripts
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

